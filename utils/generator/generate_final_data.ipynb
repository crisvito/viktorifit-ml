    "def calculate_workout_details(row):\n",
    "    \"\"\"\n",
    "    Menghitung detail lengkap sesi latihan dengan pemisahan Active Time vs Rest Time.\n",
    "    \n",
    "    Output:\n",
    "    1. Calories Burned: Dihitung dari TOTAL waktu (Active + Rest) agar akurat sesuai standar METs.\n",
    "    2. Duration_Minutes: HANYA waktu aktif (Pure Movement).\n",
    "    3. Rest_Minutes: HANYA waktu istirahat.\n",
    "    \"\"\"\n",
    "    \n",
    "    # --- 1. AMBIL DATA ---\n",
    "    weight = row.get('Weight_kg')\n",
    "    if pd.isna(weight): weight = row.get('Initial_Weight_kg_x', 60)\n",
    "\n",
    "    workout_type = str(row.get('Workout_Type', 'Strength'))\n",
    "    level = str(row.get('level_x', 'Beginner'))\n",
    "    exercise_name = str(row.get('Exercise Name', '')).lower()\n",
    "    \n",
    "    # Variabel penampung\n",
    "    active_minutes = 0 # Durasi Gerakan Murni\n",
    "    rest_minutes = 0   # Durasi Istirahat\n",
    "    total_session_time = 0 # (Active + Rest) -> Untuk hitung kalori\n",
    "    \n",
    "    # --- 2. HITUNG DURASI (Active vs Rest) ---\n",
    "    \n",
    "    # A. STRENGTH (ANGKAT BEBAN)\n",
    "    if workout_type == 'Strength':\n",
    "        try:\n",
    "            sets = int(row.get('Sets', 3))\n",
    "            \n",
    "            # LOGIKA BARU (SPLIT WAKTU):\n",
    "            # Asumsi 1 Set = 3 Menit Total\n",
    "            # - 1 Menit: Active (Angkat Beban / Time Under Tension)\n",
    "            # - 2 Menit: Rest (Istirahat antar set)\n",
    "            \n",
    "            active_minutes = sets * 1  # Pure gerakan\n",
    "            rest_minutes = sets * 2    # Istirahat\n",
    "            \n",
    "            total_session_time = active_minutes + rest_minutes # Total 3 menit/set\n",
    "            \n",
    "        except:\n",
    "            active_minutes = 4\n",
    "            rest_minutes = 8\n",
    "            total_session_time = 12\n",
    "            \n",
    "    # B. CARDIO / SPORT\n",
    "    else:\n",
    "        try:\n",
    "            reps_str = str(row.get('Reps', '30 Mins'))\n",
    "            total_cardio_time = 30 # Default\n",
    "            \n",
    "            if 'Min' in reps_str:\n",
    "                total_cardio_time = int(reps_str.replace('Mins', '').replace('Min', '').strip())\n",
    "            \n",
    "            # Cardio/Sport biasanya AKTIF TERUS (Rest = 0)\n",
    "            # Kecuali Interval Training\n",
    "            if 'interval' in exercise_name:\n",
    "                # Interval: Misal rasio Lari:Jalan = 1:1\n",
    "                active_minutes = int(total_cardio_time * 0.5)\n",
    "                rest_minutes = total_cardio_time - active_minutes\n",
    "            else:\n",
    "                # Continuous (Lari/Renang/Basket) -> Semuanya Active Time\n",
    "                active_minutes = total_cardio_time\n",
    "                rest_minutes = 0\n",
    "            \n",
    "            total_session_time = total_cardio_time\n",
    "                \n",
    "        except:\n",
    "            active_minutes = 30\n",
    "            rest_minutes = 0\n",
    "            total_session_time = 30\n",
    "\n",
    "    # --- 3. HITUNG KALORI (METs) ---\n",
    "    # NOTE: Kita pakai total_session_time untuk kalori agar hasilnya realistis\n",
    "    duration_hour = total_session_time / 60\n",
    "    met = 3.5 # Default\n",
    "    \n",
    "    if workout_type == 'Strength':\n",
    "        if level == 'Beginner': met = 3.5\n",
    "        elif level == 'Intermediate': met = 5.0\n",
    "        else: met = 6.0\n",
    "        \n",
    "    elif workout_type == 'Cardio' or workout_type == 'Sport':\n",
    "        if 'run' in exercise_name: \n",
    "            met = 9.8 if 'sprint' in exercise_name else 9.0\n",
    "        elif 'walk' in exercise_name: met = 4.3\n",
    "        elif 'badminton' in exercise_name: met = 5.5\n",
    "        elif 'football' in exercise_name: met = 8.0\n",
    "        elif 'swim' in exercise_name: met = 8.0\n",
    "        elif 'cycle' in exercise_name: met = 7.5\n",
    "        else: met = 6.0 \n",
    "\n",
    "    calories = int(met * weight * duration_hour)\n",
    "    \n",
    "    # KEMBALIKAN: [Kalori, Active Time, Rest Time]\n",
    "    return pd.Series([calories, active_minutes, rest_minutes])\n",
    "\n",
    "# --- EKSEKUSI ---\n",
    "print(\"Menghitung ulang: Kalori, Pure Duration, dan Rest Time...\")\n",
    "\n",
    "cols = ['Calories_Burned', 'Duration_Minutes', 'Rest_Minutes']\n",
    "df_final[cols] = df_final.apply(calculate_workout_details, axis=1)"
   ]
  },
